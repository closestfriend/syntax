# OPENROUTER_API_KEY: Required for every AI call (text and image models).
# Create one at https://openrouter.ai/keys and put it in `.env`.
OPENROUTER_API_KEY="sk-or-v1-..."

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional: override the routed models.
# OPENROUTER_TEXT_MODEL="google/gemini-3.8-flash"
# OPENROUTER_IMAGE_MODEL="google/gemini-nano-banana-2.1"
